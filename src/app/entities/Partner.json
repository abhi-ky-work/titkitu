{
  "name": "Partner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Partner company name"
    },
    "logo_url": {
      "type": "string",
      "description": "Partner logo URL"
    },
    "category": {
      "type": "string",
      "enum": [
        "venue",
        "sponsor",
        "technology",
        "media"
      ],
      "description": "Partner category"
    },
    "is_trusted": {
      "type": "boolean",
      "default": true,
      "description": "Trusted partner status"
    }
  },
  "required": [
    "name",
    "logo_url",
    "category"
  ]
}