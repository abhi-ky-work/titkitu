{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Event name"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "category": {
      "type": "string",
      "enum": [
        "music",
        "sports",
        "theater",
        "comedy",
        "festivals",
        "conferences",
        "nightlife",
        "food_drinks"
      ],
      "description": "Event category"
    },
    "venue": {
      "type": "string",
      "description": "Venue name"
    },
    "location": {
      "type": "string",
      "description": "Event location"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Event date"
    },
    "time": {
      "type": "string",
      "description": "Event time"
    },
    "image_url": {
      "type": "string",
      "description": "Event image URL"
    },
    "gallery_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Gallery images from past events"
    },
    "organizer_note": {
      "type": "string",
      "description": "Note from the event organizer"
    },
    "price_min": {
      "type": "number",
      "description": "Minimum ticket price"
    },
    "price_max": {
      "type": "number",
      "description": "Maximum ticket price"
    },
    "tickets_available": {
      "type": "number",
      "description": "Available tickets count"
    },
    "total_tickets": {
      "type": "number",
      "description": "Total tickets for the event"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Featured event flag"
    },
    "is_sold_out": {
      "type": "boolean",
      "default": false,
      "description": "Sold out status"
    }
  },
  "required": [
    "name",
    "description",
    "category",
    "venue",
    "location",
    "date",
    "time"
  ]
}